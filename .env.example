# MongoDB Atlas connection string (server only).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ascii-tree

# Secret mixed into client IP hashes so raw IPs are never stored.
IP_SALT=change-me

# Gifts API base used by the browser. Defaults to "/api"; set to an empty value for browser-only storage.
# NEXT_PUBLIC_GIFT_API_URL=/api
